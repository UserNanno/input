def require_file(file_path: Path) -> None:
    """Valida que exista un archivo requerido."""
    if not file_path.exists():
        raise FileNotFoundError(
            f"No se encontró el archivo requerido:\n{file_path}"
        )

    if not file_path.is_file():
        raise FileNotFoundError(
            f"La ruta existe, pero no corresponde a un archivo:\n"
            f"{file_path}"
        )


def require_columns(
    df: pd.DataFrame,
    required_columns: list[str],
    source_name: str,
) -> None:
    """Valida que existan todas las columnas requeridas."""
    missing_columns = [
        column
        for column in required_columns
        if column not in df.columns
    ]

    if missing_columns:
        raise ValueError(
            f"El archivo {source_name} no contiene todas las "
            f"columnas requeridas.\n"
            f"Columnas faltantes ({len(missing_columns)}):\n"
            + "\n".join(
                f"  - {column}"
                for column in missing_columns
            )
        )


# ============================================================
# 9. HELPERS DE NORMALIZACIÓN
# ============================================================
def normalize_spaces(value: object) -> str:
    """Limpia espacios iniciales, finales y repetidos."""
    if value is None or pd.isna(value):
        return ""

    text = str(value).strip()

    if text == "":
        return ""

    return re.sub(
        r"\s+",
        " ",
        text,
    )


def remove_accents(value: object) -> str:
    """Elimina tildes y signos diacríticos."""
    text = normalize_spaces(value)

    if text == "":
        return ""

    normalized = unicodedata.normalize(
        "NFD",
        text,
    )

    return "".join(
        char
        for char in normalized
        if unicodedata.category(char) != "Mn"
    )


def limpiar_cesado(value: object) -> str:
    """Elimina indicadores CESADO al final de un nombre."""
    text = normalize_spaces(value)

    if text == "":
        return ""

    previous = None

    while previous != text:
        previous = text

        text = re.sub(
            r"\s*-\s*CESADO\s*$",
            "",
            text,
            flags=re.IGNORECASE,
        )

        text = re.sub(
            r"\s*\(\s*CESADO\s*\)\s*$",
            "",
            text,
            flags=re.IGNORECASE,
        )

        text = re.sub(
            r"\s+CESADO\s*$",
            "",
            text,
            flags=re.IGNORECASE,
        )

        text = normalize_spaces(text)

    return text


def norm_txt(
    value: object,
    clean_cesado: bool = False,
) -> str:
    """Normaliza texto para comparaciones y cruces."""
    text = normalize_spaces(value)

    if clean_cesado:
        text = limpiar_cesado(text)

    text = text.upper()
    text = remove_accents(text)
    text = normalize_spaces(text)

    return text


def norm_codmes(value: object) -> str:
    """Normaliza CODMES conservando únicamente YYYYMM válido."""
    if value is None or pd.isna(value):
        return ""

    text = str(value).strip()

    digits = re.sub(
        r"\D",
        "",
        text,
    )

    if not re.fullmatch(r"\d{6}", digits):
        return ""

    year = int(digits[:4])
    month = int(digits[4:6])

    if year < 1000:
        return ""

    if month < 1 or month > 12:
        return ""

    return digits


