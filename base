def load_solicitudes(
    file_path: Path,
) -> pd.DataFrame:
    """Carga y normaliza INF_SOLICITUDES.csv."""
    require_file(file_path)

    df = pd.read_csv(
        file_path,
        sep=",",
        dtype=str,
        keep_default_na=False,
        encoding="cp1252",
    )

    require_columns(
        df,
        SOLICITUDES_REQUIRED_COLUMNS,
        "INF_SOLICITUDES.csv",
    )

    df = df[
        SOLICITUDES_REQUIRED_COLUMNS
    ].copy()

    df = df.rename(
        columns=SOLICITUDES_RENAME
    )

    df["NUMOPORTUNIDAD"] = (
        df["NUMOPORTUNIDAD"]
        .fillna("")
        .astype(str)
        .str.strip()
    )

    general_text_columns = [
        "NBRPASO",
        "ESTADOSOLICITUDPASO",
        "NBRPASOPENDIENTE",
        "PROCESO",
    ]

    for column in general_text_columns:
        df[column] = df[column].map(
            norm_txt
        )

    actor_columns = [
        "NBRULTACTOR",
        "NBRULTACTORPASO",
    ]

    for column in actor_columns:
        df[column] = df[column].map(
            lambda value: norm_txt(
                value,
                clean_cesado=True,
            )
        )

    df["FECHORINICIOEVALUACION"] = (
        parse_fecha_hora_esp(
            df["FECINICIO_RAW"]
        )
    )

    df["FECHORFINEVALUACION"] = (
        parse_fecha_hora_esp(
            df["FECFIN_RAW"]
        )
    )

    df["TS_EVENTO"] = (
        df["FECHORFINEVALUACION"]
        .combine_first(
            df["FECHORINICIOEVALUACION"]
        )
    )

    return df


