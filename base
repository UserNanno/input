# 10. HELPERS DE FECHAS
# ============================================================
def parse_fecha_hora_esp(series: pd.Series) -> pd.Series:
    """Convierte fechas Salesforce en español a datetime."""
    text = (
        series
        .fillna("")
        .astype(str)
        .str.strip()
    )

    text = text.str.replace(
        r"(?i)\ba\.\s*m\.\s*",
        "AM",
        regex=True,
    )

    text = text.str.replace(
        r"(?i)\bp\.\s*m\.\s*",
        "PM",
        regex=True,
    )

    text = text.str.replace(
        r"(?i)\ba\s*m\s*$",
        "AM",
        regex=True,
    )

    text = text.str.replace(
        r"(?i)\bp\s*m\s*$",
        "PM",
        regex=True,
    )

    text = text.str.strip()

    parsed = pd.to_datetime(
        text,
        format="%d/%m/%Y %I:%M %p",
        errors="coerce",
    )

    failed_mask = (
        parsed.isna()
        & text.ne("")
    )

    if failed_mask.any():
        fallback = pd.to_datetime(
            text.loc[failed_mask],
            dayfirst=True,
            errors="coerce",
        )

        parsed.loc[failed_mask] = fallback

    return parsed


def codmes_from_timestamp(
    series: pd.Series,
) -> pd.Series:
    """Obtiene YYYYMM desde una serie datetime."""
    result = pd.Series(
        "",
        index=series.index,
        dtype="string",
    )

    valid_mask = series.notna()

    if valid_mask.any():
        result.loc[valid_mask] = (
            series.loc[valid_mask]
            .dt.strftime("%Y%m")
            .astype("string")
        )

    return result.fillna("")


def format_timestamp_series(
    series: pd.Series,
) -> pd.Series:
    """Formatea datetime como YYYY-MM-DD HH:MM:SS."""
    result = pd.Series(
        "",
        index=series.index,
        dtype="string",
    )

    valid_mask = series.notna()

    if valid_mask.any():
        result.loc[valid_mask] = (
            series.loc[valid_mask]
            .dt.strftime("%Y-%m-%d %H:%M:%S")
            .astype("string")
        )

    return result.fillna("")


