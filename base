# 10. CARGA DE ORGANICO.csv
# ============================================================
def load_organico(
    file_path: Path,
) -> pd.DataFrame:
    """Carga, normaliza y valida ORGANICO.csv."""
    require_file(file_path)
    df = pd.read_csv(
        file_path,
        sep=";",
        dtype=str,
        keep_default_na=False,
        encoding="utf-8-sig",
    )
    require_columns(
        df,
        ORGANICO_REQUIRED_COLUMNS,
        "ORGANICO.csv",
    )
    df = df[
        ORGANICO_USE_COLUMNS
    ].copy()
    df["CODMES"] = (
        df["CODMES"]
        .map(norm_codmes)
    )
    df["NOMBRE_INFORME"] = (
        df["NOMBRE_INFORME"]
        .map(
            lambda value: norm_txt(
                value,
                clean_cesado=True,
            )
        )
    )
    df["MATRICULA"] = (
        df["MATRICULA"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    # NOMBRE_COMPLETO y UNIDAD_ORGANIZATIVA
    # mantienen su presentación original.
    df["NOMBRE_COMPLETO"] = (
        df["NOMBRE_COMPLETO"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    df["UNIDAD_ORGANIZATIVA"] = (
        df["UNIDAD_ORGANIZATIVA"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    # Solo registros utilizables para una coincidencia real.
    df = df.loc[
        df["CODMES"].ne("")
        & df["NOMBRE_INFORME"].ne("")
        & df["MATRICULA"].ne("")
    ].copy()
    # --------------------------------------------------------
    # VALIDACIÓN DE AMBIGÜEDAD
    #
    # CODMES + NOMBRE_INFORME no puede representar
    # varias matrículas diferentes.
    # --------------------------------------------------------
    matriculas_per_name = (
        df.groupby(
            [
                "CODMES",
                "NOMBRE_INFORME",
            ],
            dropna=False,
        )["MATRICULA"]
        .nunique()
        .reset_index(
            name="CANT_MATRICULAS"
        )
    )
    ambiguous = matriculas_per_name.loc[
        matriculas_per_name[
            "CANT_MATRICULAS"
        ] > 1
    ].copy()
    if not ambiguous.empty:
        examples = (
            ambiguous[
                [
                    "CODMES",
                    "NOMBRE_INFORME",
                    "CANT_MATRICULAS",
                ]
            ]
            .head(10)
            .to_string(index=False)
        )
        raise ValueError(
            "Se detectaron combinaciones ambiguas en "
            "ORGANICO.csv.\n"
            "Dentro de un mismo CODMES + NOMBRE_INFORME "
            "existen varias matrículas distintas.\n"
            f"Cantidad de casos ambiguos: "
            f"{len(ambiguous):,}\n"
            f"Primeros 10 ejemplos:\n{examples}"
        )
    df = df.drop_duplicates(
        subset=[
            "CODMES",
            "NOMBRE_INFORME",
        ],
        keep="first",
    ).copy()
    return df.reset_index(drop=True)
