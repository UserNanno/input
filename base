    df = pd.read_csv(
        file_path,
        sep=",",
        dtype=str,
        keep_default_na=False,
        encoding="utf-8-sig",
    )
    require_columns(
        df,
        SOLICITUDES_REQUIRED_COLUMNS,
        "INF_SOLICITUDES.csv",
    )
    df = df[
        SOLICITUDES_REQUIRED_COLUMNS
    ].copy()
