# 11. IDENTIFICACIÓN DEL PASO ANALISTA
# ============================================================
def is_tc(
    df: pd.DataFrame,
) -> pd.Series:
    """Identifica procesos de Tarjeta de Crédito."""
    return (
        df["PROCESO"]
        .fillna("")
        .astype(str)
        .str.contains(
            TEXTO_PROCESO_TC,
            regex=False,
        )
    )
def is_cef(
    df: pd.DataFrame,
) -> pd.Series:
    """Identifica procesos CEF."""
    return df["PROCESO"].isin(
        PROCESOS_CEF
    )
def es_paso_analista(
    df: pd.DataFrame,
) -> pd.Series:
    """Identifica los pasos correspondientes al analista."""
    paso_tc = (
        df["NBRPASO"]
        .eq(PASO_ANALISTA_TC)
    )
    paso_cef = (
        df["NBRPASO"]
        .eq(PASO_ANALISTA_CEF)
    )
    return (
        (is_tc(df) & paso_tc)
        | (is_cef(df) & paso_cef)
    )
