# 16. EXPORTACIÓN
# ============================================================
def export_output(
    snapshot: pd.DataFrame,
    output_file: Path,
) -> int:
    """Prepara y exporta el CSV final."""
    output_file.parent.mkdir(
        parents=True,
        exist_ok=True,
    )
    if snapshot.empty:
        output = pd.DataFrame(
            columns=FINAL_COLUMNS
        )
    else:
        output = snapshot.copy()
        # ----------------------------------------------------
        # FORMATO FINAL DE FECHAS
        # ----------------------------------------------------
        output[
            "FH_LLEGA_ANALISTA"
        ] = format_timestamp_series(
            output[
                "FH_LLEGA_ANALISTA"
            ]
        )
        output[
            "FH_FIN_ANALISTA"
        ] = format_timestamp_series(
            output[
                "FH_FIN_ANALISTA"
            ]
        )
        # ----------------------------------------------------
        # FLAGS COMO Int64
        # ----------------------------------------------------
        for column in FLAG_COLUMNS:
            output[column] = (
                output[column]
                .astype("Int64")
            )
        # ----------------------------------------------------
        # COLUMNAS DE TEXTO
        # ----------------------------------------------------
        text_columns = [
            "NUMOPORTUNIDAD",
            "CODMESEVALUACION",
            "NOMBRE_COMPLETO",
            "UNIDAD_ORGANIZATIVA",
            "PROCESO",
            "RESULTADOANALISTA",
            "FH_LLEGA_ANALISTA",
            "FH_FIN_ANALISTA",
            "FH_ACTUALIZACION_ARCHIVO",
        ]
        for column in text_columns:
            output[column] = (
                output[column]
                .fillna("")
                .astype(str)
            )
        # ----------------------------------------------------
        # SELECCIÓN EXPLÍCITA DE LAS 14 COLUMNAS
        # ----------------------------------------------------
        output = output[
            FINAL_COLUMNS
        ].copy()
    if list(output.columns) != FINAL_COLUMNS:
        raise ValueError(
            "Las columnas finales no coinciden "
            "exactamente con la estructura requerida.\n"
            f"Esperadas: {FINAL_COLUMNS}\n"
            f"Obtenidas: {list(output.columns)}"
        )
    output.to_csv(
        output_file,
        sep=";",
        index=False,
        encoding="utf-8-sig",
        na_rep="",
    )
    return len(output)
