# 15. CONSTRUCCIÓN DEL SNAPSHOT
# ============================================================
def build_snapshot(
    solicitudes: pd.DataFrame,
    organico: pd.DataFrame,
    fh_actualizacion_archivo: str,
) -> tuple[pd.DataFrame, pd.DataFrame]:
    """Construye una fila por oportunidad evaluada por analista."""
    mask_analista = es_paso_analista(
        solicitudes
    )

    eventos = solicitudes.loc[
        mask_analista
    ].copy()

    if eventos.empty:
        empty_snapshot = pd.DataFrame(
            columns=FINAL_COLUMNS
        )

        return (
            empty_snapshot,
            eventos,
        )

    eventos = eventos.sort_values(
        by=[
            "NUMOPORTUNIDAD",
            "TS_EVENTO",
            "FECHORFINEVALUACION",
            "FECHORINICIOEVALUACION",
        ],
        ascending=[
            True,
            False,
            False,
            False,
        ],
        na_position="last",
        kind="stable",
    ).copy()

    expected_opportunities = (
        eventos["NUMOPORTUNIDAD"]
        .nunique(dropna=False)
    )

    ultimo_evento = (
        eventos
        .drop_duplicates(
            subset=[
                "NUMOPORTUNIDAD",
            ],
            keep="first",
        )[
            [
                "NUMOPORTUNIDAD",
                "PROCESO",
                "NBRULTACTOR",
                "NBRULTACTORPASO",
            ]
        ]
        .copy()
    )

    fechas = (
        eventos
        .groupby(
            "NUMOPORTUNIDAD",
            as_index=False,
            dropna=False,
        )
        .agg(
            FH_LLEGA_ANALISTA=(
                "FECHORINICIOEVALUACION",
                "min",
            ),
            FH_FIN_ANALISTA=(
                "FECHORFINEVALUACION",
                "max",
            ),
        )
    )

    eventos_fuertes = eventos.loc[
        eventos[
            "ESTADOSOLICITUDPASO"
        ].isin(
            ESTADOS_FUERTES
        )
    ].copy()

    if eventos_fuertes.empty:
        ultimo_fuerte = pd.DataFrame(
            columns=[
                "NUMOPORTUNIDAD",
                "RESULTADO_FUERTE",
            ]
        )

    else:
        ultimo_fuerte = (
            eventos_fuertes
            .drop_duplicates(
                subset=[
                    "NUMOPORTUNIDAD",
                ],
                keep="first",
            )[
                [
                    "NUMOPORTUNIDAD",
                    "ESTADOSOLICITUDPASO",
                ]
            ]
            .rename(
                columns={
                    "ESTADOSOLICITUDPASO":
                        "RESULTADO_FUERTE",
                }
            )
            .copy()
        )

    recuperada_historica = (
        eventos
        .assign(
            _ES_RECUPERADA=(
                eventos[
                    "ESTADOSOLICITUDPASO"
                ].eq(
                    ESTADO_RECUPERADA
                )
            )
        )
        .groupby(
            "NUMOPORTUNIDAD",
            as_index=False,
            dropna=False,
        )["_ES_RECUPERADA"]
        .max()
        .rename(
            columns={
                "_ES_RECUPERADA":
                    "TUVO_RECUPERADA",
            }
        )
    )

    snapshot = ultimo_evento.merge(
        fechas,
        how="inner",
        on="NUMOPORTUNIDAD",
        validate="one_to_one",
    )

    snapshot = snapshot.merge(
        ultimo_fuerte,
        how="left",
        on="NUMOPORTUNIDAD",
        validate="one_to_one",
    )

    snapshot = snapshot.merge(
        recuperada_historica,
        how="left",
        on="NUMOPORTUNIDAD",
        validate="one_to_one",
    )

    snapshot["TUVO_RECUPERADA"] = (
        snapshot["TUVO_RECUPERADA"]
        .fillna(False)
        .astype(bool)
    )

    tiene_estado_fuerte = (
        snapshot["RESULTADO_FUERTE"]
        .fillna("")
        .astype(str)
        .isin(
            ESTADOS_FUERTES
        )
    )

    snapshot["RESULTADOANALISTA"] = np.select(
        [
            tiene_estado_fuerte,
            snapshot["TUVO_RECUPERADA"],
        ],
        [
            snapshot[
                "RESULTADO_FUERTE"
            ].fillna(""),
            ESTADO_RECUPERADA,
        ],
        default="PENDIENTE",
    )

    snapshot["RESULTADOANALISTA"] = (
        pd.Series(
            snapshot["RESULTADOANALISTA"],
            index=snapshot.index,
        )
        .fillna("PENDIENTE")
        .astype(str)
    )

    snapshot["FLG_APROBADO"] = (
        snapshot[
            "RESULTADOANALISTA"
        ]
        .eq("APROBADO")
        .astype("Int64")
    )

    snapshot["FLG_RECHAZADO"] = (
        snapshot[
            "RESULTADOANALISTA"
        ]
        .eq("RECHAZADO")
        .astype("Int64")
    )

    snapshot["FLG_RECUPERADA"] = (
        snapshot[
            "RESULTADOANALISTA"
        ]
        .eq("RECUPERADA")
        .astype("Int64")
    )

    snapshot["FLG_PENDIENTE"] = (
        snapshot[
            "RESULTADOANALISTA"
        ]
        .eq("PENDIENTE")
        .astype("Int64")
    )

    snapshot["FLGSTATUSRECUPERADA"] = (
        snapshot["TUVO_RECUPERADA"]
        .astype("Int64")
    )

    snapshot["CODMESEVALUACION"] = (
        codmes_from_timestamp(
            snapshot[
                "FH_LLEGA_ANALISTA"
            ]
        )
    )

    snapshot = (
        enrich_analista_con_organico(
            snapshot=snapshot,
            organico=organico,
        )
    )

    snapshot[
        "FH_ACTUALIZACION_ARCHIVO"
    ] = fh_actualizacion_archivo

    if len(snapshot) != expected_opportunities:
        raise ValueError(
            "La cantidad de filas consolidadas no coincide "
            "con la cantidad de oportunidades únicas del "
            "paso analista.\n"
            f"Oportunidades esperadas: "
            f"{expected_opportunities:,}\n"
            f"Filas consolidadas: "
            f"{len(snapshot):,}"
        )

    return (
        snapshot,
        eventos,
    )


# ============================================================
# 16. VALIDACIONES DEL RESULTADO
# ============================================================
def validate_snapshot(
    snapshot: pd.DataFrame,
    eventos_analista: pd.DataFrame,
) -> None:
    """Ejecuta validaciones finales de consistencia."""
    if eventos_analista.empty:
        if not snapshot.empty:
            raise ValueError(
                "No existen eventos del paso analista, "
                "pero el snapshot contiene registros."
            )
        return

    duplicated_mask = (
        snapshot[
            "NUMOPORTUNIDAD"
        ]
        .duplicated(
            keep=False
        )
    )

    if duplicated_mask.any():
        duplicated_values = (
            snapshot.loc[
                duplicated_mask,
                "NUMOPORTUNIDAD",
            ]
            .drop_duplicates()
            .tolist()
        )

        raise ValueError(
            "Se detectaron NUMOPORTUNIDAD duplicados "
            "en el snapshot.\n"
            f"Cantidad de oportunidades duplicadas: "
            f"{len(duplicated_values):,}\n"
            f"Primeros ejemplos: "
            f"{duplicated_values[:10]}"
        )

    expected_count = (
        eventos_analista[
            "NUMOPORTUNIDAD"
        ]
        .nunique(
            dropna=False
        )
    )

    if len(snapshot) != expected_count:
        raise ValueError(
            "La cantidad final de filas no coincide "
            "con las oportunidades únicas del paso "
            "analista.\n"
            f"Esperadas: {expected_count:,}\n"
            f"Obtenidas: {len(snapshot):,}"
        )

    flag_sum = (
        snapshot["FLG_APROBADO"]
        + snapshot["FLG_RECHAZADO"]
        + snapshot["FLG_RECUPERADA"]
        + snapshot["FLG_PENDIENTE"]
    )

    invalid_flags = flag_sum.ne(1)

    if invalid_flags.any():
        examples = (
            snapshot.loc[
                invalid_flags,
                [
                    "NUMOPORTUNIDAD",
                    "RESULTADOANALISTA",
                    "FLG_APROBADO",
                    "FLG_RECHAZADO",
                    "FLG_RECUPERADA",
                    "FLG_PENDIENTE",
                ],
            ]
            .head(10)
            .to_string(index=False)
        )

        raise ValueError(
            "Los flags finales no son mutuamente "
            "excluyentes.\n"
            "La suma debe ser exactamente 1.\n"
            f"Ejemplos:\n{examples}"
        )

    expected_recuperada = (
        eventos_analista
        .assign(
            _RECUPERADA=(
                eventos_analista[
                    "ESTADOSOLICITUDPASO"
                ].eq(
                    ESTADO_RECUPERADA
                )
            )
        )
        .groupby(
            "NUMOPORTUNIDAD",
            dropna=False,
        )["_RECUPERADA"]
        .max()
        .astype("Int64")
    )

    actual_recuperada = (
        snapshot
        .set_index(
            "NUMOPORTUNIDAD"
        )[
            "FLGSTATUSRECUPERADA"
        ]
        .astype("Int64")
    )

    expected_recuperada = (
        expected_recuperada
        .reindex(
            actual_recuperada.index
        )
    )

    mismatch_recuperada = (
        actual_recuperada
        .ne(
            expected_recuperada
        )
        .fillna(True)
    )

    if mismatch_recuperada.any():
        affected = (
            actual_recuperada
            .index[
                mismatch_recuperada
            ]
            .tolist()
        )

        raise ValueError(
            "FLGSTATUSRECUPERADA no coincide con "
            "el histórico real de RECUPERADA.\n"
            f"Primeras oportunidades afectadas: "
            f"{affected[:10]}"
        )

    expected_fin = (
        eventos_analista
        .groupby(
            "NUMOPORTUNIDAD",
            dropna=False,
        )[
            "FECHORFINEVALUACION"
        ]
        .max()
    )

    actual_fin = (
        snapshot
        .set_index(
            "NUMOPORTUNIDAD"
        )[
            "FH_FIN_ANALISTA"
        ]
    )

    expected_fin = (
        expected_fin
        .reindex(
            actual_fin.index
        )
    )

    same_fin = (
        actual_fin.eq(
            expected_fin
        )
        | (
            actual_fin.isna()
            & expected_fin.isna()
        )
    )

    if not same_fin.all():
        affected = (
            actual_fin
            .index[
                ~same_fin
            ]
            .tolist()
        )

        raise ValueError(
            "FH_FIN_ANALISTA no coincide con "
            "MAX(FECHORFINEVALUACION).\n"
            f"Primeras oportunidades afectadas: "
            f"{affected[:10]}"
        )

    expected_inicio = (
        eventos_analista
        .groupby(
            "NUMOPORTUNIDAD",
            dropna=False,
        )[
            "FECHORINICIOEVALUACION"
        ]
        .min()
    )

    actual_inicio = (
        snapshot
        .set_index(
            "NUMOPORTUNIDAD"
        )[
            "FH_LLEGA_ANALISTA"
        ]
    )

    expected_inicio = (
        expected_inicio
        .reindex(
            actual_inicio.index
        )
    )

    same_inicio = (
        actual_inicio.eq(
            expected_inicio
        )
        | (
            actual_inicio.isna()
            & expected_inicio.isna()
        )
    )

    if not same_inicio.all():
        affected = (
            actual_inicio
            .index[
                ~same_inicio
            ]
            .tolist()
        )

        raise ValueError(
            "FH_LLEGA_ANALISTA no coincide con "
            "MIN(FECHORINICIOEVALUACION).\n"
            f"Primeras oportunidades afectadas: "
            f"{affected[:10]}"
        )

    expected_codmes = (
        codmes_from_timestamp(
            snapshot[
                "FH_LLEGA_ANALISTA"
            ]
        )
        .fillna("")
        .astype(str)
    )

    actual_codmes = (
        snapshot[
            "CODMESEVALUACION"
        ]
        .fillna("")
        .astype(str)
    )

    invalid_codmes = (
        actual_codmes.ne(
            expected_codmes
        )
    )

    if invalid_codmes.any():
        examples = (
            snapshot.loc[
                invalid_codmes,
                [
                    "NUMOPORTUNIDAD",
                    "FH_LLEGA_ANALISTA",
                    "CODMESEVALUACION",
                ],
            ]
            .head(10)
            .to_string(index=False)
        )

        raise ValueError(
            "CODMESEVALUACION no corresponde al "
            "mes de FH_LLEGA_ANALISTA.\n"
            f"Ejemplos:\n{examples}"
        )

    valid_origins = {
        ORIGEN_ULTIMO_ACTOR,
        ORIGEN_ULTIMO_ACTOR_PASO,
        ORIGEN_SIN_COINCIDENCIA,
    }

    invalid_origin = (
        ~snapshot[
            "ORIGEN_ANALISTA"
        ].isin(
            valid_origins
        )
    )

    if invalid_origin.any():
        examples = (
            snapshot.loc[
                invalid_origin,
                [
                    "NUMOPORTUNIDAD",
                    "ORIGEN_ANALISTA",
                ],
            ]
            .head(10)
            .to_string(index=False)
        )

        raise ValueError(
            "Se detectaron valores inválidos en "
            "ORIGEN_ANALISTA.\n"
            f"Ejemplos:\n{examples}"
        )

    no_match = (
        snapshot[
            "ORIGEN_ANALISTA"
        ].eq(
            ORIGEN_SIN_COINCIDENCIA
        )
    )

    invalid_no_match = (
        no_match
        & (
            snapshot[
                "NOMBRE_COMPLETO"
            ]
            .fillna("")
            .ne("")
            | snapshot[
                "UNIDAD_ORGANIZATIVA"
            ]
            .fillna("")
            .ne("")
        )
    )

    if invalid_no_match.any():
        examples = (
            snapshot.loc[
                invalid_no_match,
                [
                    "NUMOPORTUNIDAD",
                    "NOMBRE_COMPLETO",
                    "UNIDAD_ORGANIZATIVA",
                    "ORIGEN_ANALISTA",
                ],
            ]
            .head(10)
            .to_string(index=False)
        )

        raise ValueError(
            "Existen oportunidades sin coincidencia "
            "de Orgánico que contienen información "
            "de analista.\n"
            f"Ejemplos:\n{examples}"
        )

    valid_results = {
        "APROBADO",
        "RECHAZADO",
        "RECUPERADA",
        "PENDIENTE",
    }

    invalid_result = (
        ~snapshot[
            "RESULTADOANALISTA"
        ].isin(
            valid_results
        )
    )

    if invalid_result.any():
        examples = (
            snapshot.loc[
                invalid_result,
                [
                    "NUMOPORTUNIDAD",
                    "RESULTADOANALISTA",
                ],
            ]
            .head(10)
            .to_string(index=False)
        )

        raise ValueError(
            "Se detectaron RESULTADOANALISTA "
            "inválidos.\n"
            f"Ejemplos:\n{examples}"
        )


