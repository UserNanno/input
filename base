# 7. HELPERS DE NORMALIZACIÓN
# ============================================================
def normalize_spaces(value: object) -> str:
    """Limpia espacios iniciales, finales y repetidos."""
    if value is None or pd.isna(value):
        return ""
    text = str(value).strip()
    if text == "":
        return ""
    return re.sub(
        r"\s+",
        " ",
        text,
    )
def remove_accents(value: object) -> str:
    """Elimina tildes y signos diacríticos."""
    text = normalize_spaces(value)
    if text == "":
        return ""
    normalized = unicodedata.normalize(
        "NFD",
        text,
    )
    return "".join(
        char
        for char in normalized
        if unicodedata.category(char) != "Mn"
    )
def limpiar_cesado(value: object) -> str:
    """Elimina indicadores CESADO al final de un nombre."""
    text = normalize_spaces(value)
    if text == "":
        return ""
    previous = None
    while previous != text:
        previous = text
        text = re.sub(
            r"\s*-\s*CESADO\s*$",
            "",
            text,
            flags=re.IGNORECASE,
        )
        text = re.sub(
            r"\s*\(\s*CESADO\s*\)\s*$",
            "",
            text,
            flags=re.IGNORECASE,
        )
        text = re.sub(
            r"\s+CESADO\s*$",
            "",
            text,
            flags=re.IGNORECASE,
        )
        text = normalize_spaces(text)
    return text
def norm_txt(
    value: object,
    clean_cesado: bool = False,
) -> str:
    """Normaliza texto para comparaciones y cruces."""
    text = normalize_spaces(value)
    if clean_cesado:
        text = limpiar_cesado(text)
    text = text.upper()
    text = remove_accents(text)
    text = normalize_spaces(text)
    return text
def norm_codmes(value: object) -> str:
    """Normaliza CODMES conservando únicamente YYYYMM válido."""
    if value is None or pd.isna(value):
        return ""
    text = str(value).strip()
    digits = re.sub(
        r"\D",
        "",
        text,
    )
    if not re.fullmatch(r"\d{6}", digits):
        return ""
    year = int(digits[:4])
    month = int(digits[4:6])
    if year < 1000:
        return ""
    if month < 1 or month > 12:
        return ""
    return digits
