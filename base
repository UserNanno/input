def build_unique_archive_path() -> Path:
    """
    Construye un nombre histórico único para evitar colisiones.
    """
    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S_%f"
    )

    return (
        ARCHIVE_DIR
        / f"INF_SOLICITUDES_{timestamp}.csv"
    )


def archive_input_file(
    source_file: Path,
) -> tuple[Path, float]:
    """
    Mueve el input recibido a /archive y retorna:
    - ruta histórica
    - fecha de modificación original
    """
    require_file(
        source_file
    )

    original_mtime = (
        source_file
        .stat()
        .st_mtime
    )

    archive_file = (
        build_unique_archive_path()
    )

    ARCHIVE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    shutil.move(
        str(source_file),
        str(archive_file),
    )

    logger.info(
        "Archivo movido a archive: %s",
        archive_file,
    )

    return (
        archive_file,
        original_mtime,
    )


