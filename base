        columns=SOLICITUDES_RENAME
    )
    df["NUMOPORTUNIDAD"] = (
        df["NUMOPORTUNIDAD"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    general_text_columns = [
        "NBRPASO",
        "ESTADOSOLICITUDPASO",
        "NBRPASOPENDIENTE",
        "PROCESO",
    ]
    for column in general_text_columns:
        df[column] = df[column].map(
            norm_txt
        )
    actor_columns = [
        "NBRULTACTOR",
        "NBRULTACTORPASO",
    ]
    for column in actor_columns:
        df[column] = df[column].map(
            lambda value: norm_txt(
                value,
