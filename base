# 18. EXPORTACIÓN ATÓMICA
# ============================================================
def export_output(
    snapshot: pd.DataFrame,
    output_file: Path,
) -> int:
    """
    Prepara y exporta el CSV final.

    Primero escribe a un archivo temporal y después reemplaza
    el archivo definitivo para evitar que Excel/Power Query
    lea un CSV mientras todavía se está escribiendo.
    """
    output_file.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    if snapshot.empty:
        output = pd.DataFrame(
            columns=FINAL_COLUMNS
        )

    else:
        output = snapshot.copy()

        output[
            "FH_LLEGA_ANALISTA"
        ] = format_timestamp_series(
            output[
                "FH_LLEGA_ANALISTA"
            ]
        )

        output[
            "FH_FIN_ANALISTA"
        ] = format_timestamp_series(
            output[
                "FH_FIN_ANALISTA"
            ]
        )

        for column in FLAG_COLUMNS:
            output[column] = (
                output[column]
                .astype("Int64")
            )

        text_columns = [
            "NUMOPORTUNIDAD",
            "CODMESEVALUACION",
            "NOMBRE_COMPLETO",
            "UNIDAD_ORGANIZATIVA",
            "PROCESO",
            "RESULTADOANALISTA",
            "FH_LLEGA_ANALISTA",
            "FH_FIN_ANALISTA",
            "FH_ACTUALIZACION_ARCHIVO",
        ]

        for column in text_columns:
            output[column] = (
                output[column]
                .fillna("")
                .astype(str)
            )

        output = output[
            FINAL_COLUMNS
        ].copy()

    if list(output.columns) != FINAL_COLUMNS:
        raise ValueError(
            "Las columnas finales no coinciden "
            "exactamente con la estructura requerida.\n"
            f"Esperadas: {FINAL_COLUMNS}\n"
            f"Obtenidas: {list(output.columns)}"
        )

    temp_file = output_file.with_name(
        f"{output_file.stem}__TEMP{output_file.suffix}"
    )

    if temp_file.exists():
        try:
            temp_file.unlink()
        except Exception:
            pass

    output.to_csv(
        temp_file,
        sep=";",
        index=False,
        encoding="utf-8-sig",
        na_rep="",
    )

    os.replace(
        temp_file,
        output_file,
    )

    return len(output)


# ============================================================
# 19. VALIDACIÓN DE ARCHIVO DE ENTRADA
# ============================================================
def is_file_readable(
    file_path: Path,
) -> bool:
    """
    Intenta abrir el archivo para validar que ya esté disponible.
    """
    try:
        with file_path.open(
            "rb"
        ) as file:
            file.read(1)

        return True

    except (
        PermissionError,
        OSError,
    ):
        return False


def wait_until_file_is_ready(
    file_path: Path,
) -> None:
    """
    Espera hasta que el archivo deje de crecer/cambiar y pueda
    abrirse correctamente.
    """
    logger.info(
        "Verificando que INF_SOLICITUDES.csv haya terminado de copiarse..."
    )

    previous_size = None
    previous_mtime_ns = None

    for attempt in range(
        1,
        FILE_READY_MAX_ATTEMPTS + 1,
    ):
        if not file_path.exists():
            raise FileNotFoundError(
                f"El archivo desapareció durante la validación:\n"
                f"{file_path}"
            )

        try:
            stat = file_path.stat()
        except OSError:
            time.sleep(
                FILE_STABLE_SECONDS
            )
            continue

        current_size = stat.st_size
        current_mtime_ns = stat.st_mtime_ns

        stable = (
            previous_size is not None
            and previous_mtime_ns is not None
            and current_size == previous_size
            and current_mtime_ns == previous_mtime_ns
        )

        if (
            stable
            and current_size > 0
            and is_file_readable(file_path)
        ):
            logger.info(
                "Archivo de entrada estable y disponible."
            )
            return

        previous_size = current_size
        previous_mtime_ns = current_mtime_ns

        logger.info(
            "Archivo aún no está listo. "
            "Intento %s/%s...",
            attempt,
            FILE_READY_MAX_ATTEMPTS,
        )

        time.sleep(
            FILE_STABLE_SECONDS
        )

    raise TimeoutError(
        "El archivo INF_SOLICITUDES.csv no quedó estable "
        "dentro del tiempo máximo de espera."
    )


