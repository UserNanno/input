# 21. ACTUALIZACIÓN DE EXCEL
# ============================================================
def refresh_pivot_tables(
    workbook,
) -> int:
    """
    Refresca todas las tablas dinámicas del libro.
    Retorna cuántas tablas dinámicas intentó actualizar.
    """
    pivot_count = 0

    for worksheet in workbook.Worksheets:
        try:
            pivot_tables = worksheet.PivotTables()
            count = pivot_tables.Count

        except Exception:
            continue

        for index in range(
            1,
            count + 1,
        ):
            pivot = pivot_tables.Item(
                index
            )

            pivot_count += 1

            try:
                pivot.PivotCache().Refresh()

            except Exception as exc:
                logger.warning(
                    "No se pudo refrescar una tabla dinámica "
                    "en la hoja '%s': %s",
                    worksheet.Name,
                    exc,
                )

    return pivot_count


def refresh_excel(
    excel_file: Path,
) -> None:
    """
    Abre Excel en segundo plano, actualiza Power Query/
    conexiones, tablas dinámicas, recalcula y guarda.
    """
    require_file(
        excel_file
    )

    last_error = None

    for attempt in range(
        1,
        EXCEL_OPEN_RETRIES + 1,
    ):
        excel = None
        workbook = None

        try:
            logger.info(
                "Actualizando Excel. Intento %s/%s...",
                attempt,
                EXCEL_OPEN_RETRIES,
            )

            pythoncom.CoInitialize()

            excel = win32com.client.DispatchEx(
                "Excel.Application"
            )

            excel.Visible = False
            excel.DisplayAlerts = False
            excel.ScreenUpdating = False
            excel.EnableEvents = False

            workbook = excel.Workbooks.Open(
                str(excel_file),
                UpdateLinks=0,
                ReadOnly=False,
            )

            if workbook.ReadOnly:
                raise PermissionError(
                    "SEGUIMIENTO_DESEMPEÑO.xlsx fue abierto "
                    "en modo solo lectura. Probablemente está "
                    "bloqueado por otra sesión de Excel."
                )

            logger.info(
                "Ejecutando RefreshAll()..."
            )

            workbook.RefreshAll()

            try:
                excel.CalculateUntilAsyncQueriesDone()
            except Exception as exc:
                logger.warning(
                    "CalculateUntilAsyncQueriesDone() no pudo "
                    "ejecutarse completamente: %s",
                    exc,
                )

            time.sleep(
                EXCEL_POST_REFRESH_WAIT_SECONDS
            )

            logger.info(
                "Actualizando tablas dinámicas..."
            )

            pivot_count = (
                refresh_pivot_tables(
                    workbook
                )
            )

            try:
                excel.CalculateFull()
            except Exception as exc:
                logger.warning(
                    "No se pudo ejecutar CalculateFull(): %s",
                    exc,
                )

            workbook.Save()

            logger.info(
                "Excel guardado correctamente. "
                "Tablas dinámicas procesadas: %s",
                pivot_count,
            )

            return

        except Exception as exc:
            last_error = exc

            logger.exception(
                "Error actualizando Excel en intento %s/%s.",
                attempt,
                EXCEL_OPEN_RETRIES,
            )

            if attempt < EXCEL_OPEN_RETRIES:
                time.sleep(
                    EXCEL_OPEN_RETRY_SECONDS
                )

        finally:
            if workbook is not None:
                try:
                    workbook.Close(
                        SaveChanges=False
                    )
                except Exception:
                    pass

            if excel is not None:
                try:
                    excel.Quit()
                except Exception:
                    pass

            try:
                pythoncom.CoUninitialize()
            except Exception:
                pass

    raise RuntimeError(
        "No fue posible actualizar "
        f"{excel_file.name} después de "
        f"{EXCEL_OPEN_RETRIES} intentos."
    ) from last_error


# ============================================================
# 22. PROCESAMIENTO PRINCIPAL DE UN INPUT
# ============================================================
def run(
    input_file: Path,
    input_mtime: float,
) -> None:
    """
    Ejecuta el procesamiento de un archivo INF_SOLICITUDES
    previamente archivado.
    """
    print()
    print("=" * 70)
    print(
        "INICIO - SEGUIMIENTO DIARIO DE PRODUCCIÓN DE ANALISTAS"
    )
    print("=" * 70)
    print()

    require_file(
        input_file
    )

    require_file(
        ORGANICO_FILE
    )

    fh_actualizacion_archivo = (
        datetime.fromtimestamp(
            input_mtime
        )
        .strftime(
            "%Y-%m-%d %H:%M:%S"
        )
    )

    print(
        "FH_ACTUALIZACION_ARCHIVO: "
        f"{fh_actualizacion_archivo}"
    )

    print()
    print(
        "Leyendo INF_SOLICITUDES.csv..."
    )

    solicitudes = load_solicitudes(
        input_file
    )

    input_rows = len(
        solicitudes
    )

    print(
        "Filas leídas de INF_SOLICITUDES.csv: "
        f"{input_rows:,}"
    )

    print()
    print(
        "Leyendo ORGANICO.csv..."
    )

    organico = load_organico(
        ORGANICO_FILE
    )

    organico_rows = len(
        organico
    )

    print(
        "Filas válidas de ORGANICO.csv: "
        f"{organico_rows:,}"
    )

    print()
    print(
        "Identificando eventos del paso analista..."
    )

    snapshot, eventos_analista = (
        build_snapshot(
            solicitudes=solicitudes,
            organico=organico,
            fh_actualizacion_archivo=(
                fh_actualizacion_archivo
            ),
        )
    )

    cantidad_eventos = len(
        eventos_analista
    )

    if eventos_analista.empty:
        oportunidades_filtradas = 0

    else:
        oportunidades_filtradas = (
            eventos_analista[
                "NUMOPORTUNIDAD"
            ]
            .nunique(
                dropna=False
            )
        )

    print(
        "Eventos identificados como paso analista: "
        f"{cantidad_eventos:,}"
    )

    print(
        "Oportunidades únicas después del filtro: "
        f"{oportunidades_filtradas:,}"
    )

    print()
    print(
        "Ejecutando validaciones de consistencia..."
    )

    validate_snapshot(
        snapshot=snapshot,
        eventos_analista=eventos_analista,
    )

    print(
        "Validaciones completadas correctamente."
    )

    show_summary(
        input_rows=input_rows,
        organico_rows=organico_rows,
        eventos_analista=eventos_analista,
        snapshot=snapshot,
        fh_actualizacion_archivo=(
            fh_actualizacion_archivo
        ),
    )

    print(
        "Exportando resultado..."
    )

    row_count = export_output(
        snapshot=snapshot,
        output_file=OUTPUT_FILE,
    )

    print()
    print(
        "Archivo generado:"
    )

    print(
        OUTPUT_FILE
    )

    print(
        "Cantidad de filas exportadas: "
        f"{row_count:,}"
    )

    logger.info(
        "CSV final generado correctamente: %s | filas=%s",
        OUTPUT_FILE,
        row_count,
    )

    print()
    print(
        "Actualizando SEGUIMIENTO_DESEMPEÑO.xlsx..."
    )

    refresh_excel(
        EXCEL_FILE
    )

    print()
    print("=" * 70)
    print(
        "PROCESO FINALIZADO CORRECTAMENTE"
    )
    print("=" * 70)
    print()


# ============================================================
# 23. WATCHER CONTINUO
# ============================================================
def watch() -> None:
    """
    Mantiene el proceso vivo.

    Cada vez que aparece INPUT_FILE:
    1. Espera a que termine de copiarse.
    2. Lo mueve a archive.
    3. Ejecuta el procesamiento.
    4. Genera el CSV para Excel.
    5. Refresca y guarda el Excel.
    6. Vuelve a esperar otro archivo.
    """
    print()
    print("=" * 70)
    print("WATCHER - SEGUIMIENTO DESEMPEÑO ANALISTAS")
    print("=" * 70)
    print(f"Entrada esperada : {INPUT_FILE}")
    print(f"Archive          : {ARCHIVE_DIR}")
    print(f"Output CSV       : {OUTPUT_FILE}")
    print(f"Excel            : {EXCEL_FILE}")
    print(
        f"Intervalo watcher: {CHECK_INTERVAL_SECONDS} segundos"
    )
    print("=" * 70)
    print()

    logger.info(
        "Watcher iniciado."
    )

    while True:
        try:
            if not INPUT_FILE.exists():
                time.sleep(
                    CHECK_INTERVAL_SECONDS
                )
                continue

            logger.info(
                "Nuevo INF_SOLICITUDES.csv detectado: %s",
                INPUT_FILE,
            )

            wait_until_file_is_ready(
                INPUT_FILE
            )

            archived_file, original_mtime = (
                archive_input_file(
                    INPUT_FILE
                )
            )

            run(
                input_file=archived_file,
                input_mtime=original_mtime,
            )

            logger.info(
                "Ciclo completado correctamente. "
                "Esperando nuevo archivo..."
            )

        except KeyboardInterrupt:
            logger.info(
                "Watcher detenido manualmente por el usuario."
            )

            print()
            print(
                "Proceso detenido manualmente."
            )

            break

        except Exception:
            logger.exception(
                "El ciclo actual terminó con error. "
                "El watcher continuará activo."
            )

            print()
            print(
                "Ocurrió un error en el ciclo actual."
            )
            print(
                f"Revisa el log: {LOG_FILE}"
            )
            print(
                "El watcher continuará esperando nuevos archivos."
            )
            print()

        time.sleep(
            CHECK_INTERVAL_SECONDS
        )


# ============================================================
# 24. EJECUCIÓN
# ============================================================
if __name__ == "__main__":
    watch()
