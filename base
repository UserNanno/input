def show_summary(
    input_rows: int,
    organico_rows: int,
    eventos_analista: pd.DataFrame,
    snapshot: pd.DataFrame,
    fh_actualizacion_archivo: str,
) -> None:
    """Muestra el resumen del procesamiento."""
    cantidad_eventos = len(
        eventos_analista
    )

    if eventos_analista.empty:
        oportunidades_filtradas = 0
    else:
        oportunidades_filtradas = (
            eventos_analista[
                "NUMOPORTUNIDAD"
            ]
            .nunique(
                dropna=False
            )
        )

    oportunidades_finales = len(
        snapshot
    )

    if snapshot.empty:
        oportunidades_con_organico = 0
        oportunidades_sin_organico = 0
        cobertura = 0.0

    else:
        oportunidades_con_organico = int(
            snapshot[
                "ORIGEN_ANALISTA"
            ]
            .ne(
                ORIGEN_SIN_COINCIDENCIA
            )
            .sum()
        )

        oportunidades_sin_organico = int(
            snapshot[
                "ORIGEN_ANALISTA"
            ]
            .eq(
                ORIGEN_SIN_COINCIDENCIA
            )
            .sum()
        )

        cobertura = (
            oportunidades_con_organico
            / oportunidades_finales
            * 100
        )

    print()
    print("=" * 70)
    print("RESUMEN DE EJECUCIÓN")
    print("=" * 70)

    print(
        f"FH_ACTUALIZACION_ARCHIVO        : "
        f"{fh_actualizacion_archivo}"
    )

    print(
        f"Filas leídas INF_SOLICITUDES    : "
        f"{input_rows:,}"
    )

    print(
        f"Filas válidas ORGANICO           : "
        f"{organico_rows:,}"
    )

    print(
        f"Eventos del paso analista        : "
        f"{cantidad_eventos:,}"
    )

    print(
        f"Oportunidades únicas filtradas   : "
        f"{oportunidades_filtradas:,}"
    )

    print(
        f"Oportunidades finales            : "
        f"{oportunidades_finales:,}"
    )

    print(
        f"Con coincidencia en Orgánico     : "
        f"{oportunidades_con_organico:,}"
    )

    print(
        f"Sin coincidencia en Orgánico     : "
        f"{oportunidades_sin_organico:,}"
    )

    print(
        f"Cobertura de Orgánico            : "
        f"{cobertura:.2f}%"
    )

    print()
    print("RESULTADOANALISTA")
    print("-" * 70)

    result_order = [
        "APROBADO",
        "RECHAZADO",
        "RECUPERADA",
        "PENDIENTE",
    ]

    if snapshot.empty:
        result_counts = pd.Series(
            dtype="int64"
        )

    else:
        result_counts = (
            snapshot[
                "RESULTADOANALISTA"
            ]
            .value_counts(
                dropna=False
            )
        )

    for result in result_order:
        count = int(
            result_counts.get(
                result,
                0,
            )
        )

        print(
            f"{result:<30}: "
            f"{count:,}"
        )

    print()
    print("ORIGEN_ANALISTA")
    print("-" * 70)

    origin_order = [
        ORIGEN_ULTIMO_ACTOR,
        ORIGEN_ULTIMO_ACTOR_PASO,
        ORIGEN_SIN_COINCIDENCIA,
    ]

    if snapshot.empty:
        origin_counts = pd.Series(
            dtype="int64"
        )

    else:
        origin_counts = (
            snapshot[
                "ORIGEN_ANALISTA"
            ]
            .value_counts(
                dropna=False
            )
        )

    for origin in origin_order:
        count = int(
            origin_counts.get(
                origin,
                0,
            )
        )

        print(
            f"{origin:<30}: "
            f"{count:,}"
        )

    print("=" * 70)
    print()


