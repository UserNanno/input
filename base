# 12. ENRIQUECIMIENTO CONTRA ORGÁNICO
# ============================================================
def enrich_analista_con_organico(
    snapshot: pd.DataFrame,
    organico: pd.DataFrame,
) -> pd.DataFrame:
    """
    Enriquece el analista usando:
    1. NBRULTACTOR.
    2. NBRULTACTORPASO.
    3. Sin coincidencia.
    """
    result = snapshot.copy()
    organico_lookup = organico[
        [
            "CODMES",
            "NOMBRE_INFORME",
            "MATRICULA",
            "NOMBRE_COMPLETO",
            "UNIDAD_ORGANIZATIVA",
        ]
    ].copy()
    # --------------------------------------------------------
    # PRIMER CANDIDATO: NBRULTACTOR
    # --------------------------------------------------------
    org_actor = organico_lookup.rename(
        columns={
            "CODMES":
                "CODMES_ORG_ACTOR",
            "NOMBRE_INFORME":
                "NOMBRE_INFORME_ACTOR",
            "MATRICULA":
                "MATRICULA_ACTOR",
            "NOMBRE_COMPLETO":
                "NOMBRE_COMPLETO_ACTOR",
            "UNIDAD_ORGANIZATIVA":
                "UNIDAD_ORGANIZATIVA_ACTOR",
        }
    )
    result = result.merge(
        org_actor,
        how="left",
        left_on=[
            "CODMESEVALUACION",
            "NBRULTACTOR",
        ],
        right_on=[
            "CODMES_ORG_ACTOR",
            "NOMBRE_INFORME_ACTOR",
        ],
        validate="many_to_one",
    )
    # --------------------------------------------------------
    # SEGUNDO CANDIDATO: NBRULTACTORPASO
    # --------------------------------------------------------
    org_actor_paso = organico_lookup.rename(
        columns={
            "CODMES":
                "CODMES_ORG_ACTOR_PASO",
            "NOMBRE_INFORME":
                "NOMBRE_INFORME_ACTOR_PASO",
            "MATRICULA":
                "MATRICULA_ACTOR_PASO",
            "NOMBRE_COMPLETO":
                "NOMBRE_COMPLETO_ACTOR_PASO",
            "UNIDAD_ORGANIZATIVA":
                "UNIDAD_ORGANIZATIVA_ACTOR_PASO",
        }
    )
    result = result.merge(
        org_actor_paso,
        how="left",
        left_on=[
            "CODMESEVALUACION",
            "NBRULTACTORPASO",
        ],
        right_on=[
            "CODMES_ORG_ACTOR_PASO",
            "NOMBRE_INFORME_ACTOR_PASO",
        ],
        validate="many_to_one",
    )
    # --------------------------------------------------------
    # COINCIDENCIA REAL
    #
    # La existencia del nombre no es suficiente.
    # Debe existir MATRICULA en Orgánico.
    # --------------------------------------------------------
    match_actor = (
        result["MATRICULA_ACTOR"]
        .fillna("")
        .astype(str)
        .str.strip()
        .ne("")
    )
    match_actor_paso = (
        result["MATRICULA_ACTOR_PASO"]
        .fillna("")
        .astype(str)
        .str.strip()
        .ne("")
    )
    # Primer candidato solamente si realmente encontró persona.
    use_actor = match_actor
    # El segundo candidato se intenta cuando el primero
    # NO encontró coincidencia real.
    use_actor_paso = (
        ~match_actor
        & match_actor_paso
    )
    result["NOMBRE_COMPLETO"] = np.select(
        [
            use_actor,
            use_actor_paso,
        ],
        [
            result["NOMBRE_COMPLETO_ACTOR"],
            result["NOMBRE_COMPLETO_ACTOR_PASO"],
        ],
        default="",
    )
    result["UNIDAD_ORGANIZATIVA"] = np.select(
        [
            use_actor,
            use_actor_paso,
        ],
        [
            result["UNIDAD_ORGANIZATIVA_ACTOR"],
            result["UNIDAD_ORGANIZATIVA_ACTOR_PASO"],
        ],
        default="",
    )
    result["ORIGEN_ANALISTA"] = np.select(
        [
            use_actor,
            use_actor_paso,
        ],
        [
            ORIGEN_ULTIMO_ACTOR,
            ORIGEN_ULTIMO_ACTOR_PASO,
        ],
        default=ORIGEN_SIN_COINCIDENCIA,
    )
    result["NOMBRE_COMPLETO"] = (
        pd.Series(
            result["NOMBRE_COMPLETO"],
            index=result.index,
        )
        .fillna("")
        .astype(str)
        .str.strip()
    )
    result["UNIDAD_ORGANIZATIVA"] = (
        pd.Series(
            result["UNIDAD_ORGANIZATIVA"],
            index=result.index,
        )
        .fillna("")
        .astype(str)
        .str.strip()
    )
    result["ORIGEN_ANALISTA"] = (
        pd.Series(
            result["ORIGEN_ANALISTA"],
            index=result.index,
        )
        .fillna(
            ORIGEN_SIN_COINCIDENCIA
        )
        .astype(str)
    )
    # --------------------------------------------------------
    # VALIDACIÓN DE CONSISTENCIA DEL ORGÁNICO
    #
    # Nombre y unidad deben proceder siempre del mismo
    # candidato.
    # --------------------------------------------------------
    expected_name_actor = (
        result["NOMBRE_COMPLETO_ACTOR"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    expected_unit_actor = (
        result["UNIDAD_ORGANIZATIVA_ACTOR"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    expected_name_actor_paso = (
        result["NOMBRE_COMPLETO_ACTOR_PASO"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    expected_unit_actor_paso = (
        result["UNIDAD_ORGANIZATIVA_ACTOR_PASO"]
        .fillna("")
        .astype(str)
        .str.strip()
    )
    inconsistent_actor = (
        use_actor
        & (
            result["NOMBRE_COMPLETO"].ne(
                expected_name_actor
            )
            | result["UNIDAD_ORGANIZATIVA"].ne(
                expected_unit_actor
            )
        )
    )
    inconsistent_actor_paso = (
        use_actor_paso
        & (
            result["NOMBRE_COMPLETO"].ne(
                expected_name_actor_paso
            )
            | result["UNIDAD_ORGANIZATIVA"].ne(
                expected_unit_actor_paso
            )
        )
    )
    if (
        inconsistent_actor.any()
        or inconsistent_actor_paso.any()
    ):
        raise ValueError(
            "Se detectó una inconsistencia al recuperar "
            "NOMBRE_COMPLETO y UNIDAD_ORGANIZATIVA "
            "desde ORGANICO.csv."
        )
    return result
